MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_DB_NAME=crisis_monitor
QUEUE_MAX_SIZE=500
CORS_ORIGINS=http://localhost:5173
MODEL_BACKEND=auto
PIPELINE_WORKER_ENABLED=true
PIPELINE_POLL_INTERVAL=0.5
AUTHOR_HASH_SALT=change-me
DROPPED_RETENTION_DAYS=7
AUTO_ROUTE_CRITICAL_MINUTES=2
AUTO_ROUTE_HIGH_MINUTES=10
ESCALATION_CHECK_SECONDS=10
