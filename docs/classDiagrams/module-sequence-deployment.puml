@enduml

@startuml PersistentSequence
 title Persistent Module - Sequence Diagram
 participant SituationManager
 participant EvidenceManager
 participant SituationRouter
 participant DatabaseClient
 database MongoDB

 alt store situation
   SituationManager -> DatabaseClient : insertDocument("situations", document)
   DatabaseClient -> MongoDB : insert document
   MongoDB --> DatabaseClient : insert result
   DatabaseClient --> SituationManager : document ID
 else store evidence
   EvidenceManager -> DatabaseClient : insertDocument("evidence", document)
   DatabaseClient -> MongoDB : insert document
   MongoDB --> DatabaseClient : insert result
   DatabaseClient --> EvidenceManager : document ID
 else retrieve or update situation
   SituationRouter -> DatabaseClient : find/update document
   DatabaseClient -> MongoDB : query/update
   MongoDB --> DatabaseClient : database result
   DatabaseClient --> SituationRouter : mapped result
 end
@enduml

@startuml PersistentDeployment
 title Persistent Module - Deployment Diagram
 node "Application Host" {
   node "FastAPI Process" {
     component "Database Client" as Client
     artifact "Motor Async Driver" as Motor
   }
 }
 database "MongoDB Server" as Mongo {
   artifact "situations collection" as Situations
   artifact "evidence collection" as Evidence
 }
 SituationManager --> Client : uses
 EvidenceManager --> Client : uses
 SituationRouter --> Client : uses
 Client --> Motor
 Motor --> Mongo : MongoDB protocol
 Mongo o-- Situations
 Mongo o-- Evidence

 note right of Client
 The current implementation uses shared
 module-level asynchronous database helpers.
 end note
@enduml
