@enduml

@startuml ClusteringSequence
 title Clustering Module - Sequence Diagram
 participant AnalysisEngine
 participant ClusterManager
 participant EmbeddingGenerator
 participant Cluster
 participant SituationManager

 AnalysisEngine -> ClusterManager : assign AnalysisResult
 ClusterManager -> EmbeddingGenerator : generate embedding
 EmbeddingGenerator --> ClusterManager : vector
 ClusterManager -> ClusterManager : compare similarity/time/needs
 alt suitable cluster found
   ClusterManager -> Cluster : add member
   Cluster --> ClusterManager : updated centroid
 else no suitable cluster
   ClusterManager -> Cluster : create new cluster
 end
 ClusterManager --> AnalysisEngine : cluster assignment
 ClusterManager -> SituationManager : send significant cluster
@enduml

@startuml ClusteringDeployment
 title Clustering Module - Deployment Diagram
 node "Application Host" {
   node "FastAPI Process" {
     component "Clustering Router" as Router
     component "Cluster Manager" as Manager
     component "Embedding Generator" as Embedding
     component "Cluster" as Cluster
   }
   node "ML Runtime" {
     artifact "Embedding Model" as Model
     artifact "HDBSCAN Library" as HDBSCAN
   }
 }
 Router --> Manager
 Manager --> Embedding
 Manager o-- Cluster
 Embedding --> Model
 Manager --> HDBSCAN : periodic reclustering
@enduml

@startuml SituationSequence
 title Situation Module - Sequence Diagram
 participant ClusterManager
 participant SituationManager
 participant Summarizer
 participant Situation
 participant DatabaseClient
 actor Reviewer
 participant SituationRouter

 ClusterManager -> SituationManager : submit significant cluster
 SituationManager -> Summarizer : generate summary
 Summarizer --> SituationManager : summary
 SituationManager -> Situation : create pending situation
 SituationManager -> DatabaseClient : save situation
 DatabaseClient --> SituationManager : stored ID
 Reviewer -> SituationRouter : approve/reject situation
 SituationRouter -> SituationManager : update decision
 SituationManager -> DatabaseClient : update status
 DatabaseClient --> SituationRouter : updated situation
 SituationRouter --> Reviewer : decision result
@enduml

@startuml SituationDeployment
 title Situation Module - Deployment Diagram
 node "Application Host" {
   node "FastAPI Process" {
     component "Situation Router" as Router
