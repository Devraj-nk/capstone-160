' ============================================================================
' Per-module sequence and deployment diagrams
' Disaster Information Analysis System
'
' Exactly two diagrams are provided for each of the eight modules:
' one sequence diagram and one deployment diagram (16 diagrams total).
' ============================================================================

@startuml PresentationSequence
 title Presentation Layer - Sequence Diagram
 actor User
 participant FrontEnd
 participant APIClient
 participant FastAPIApp
 participant SituationRouter
 database MongoDB

 User -> FrontEnd : open review/dashboard
 FrontEnd -> APIClient : request situations/analytics
 APIClient -> FastAPIApp : HTTP GET request
 FastAPIApp -> SituationRouter : route request
 SituationRouter -> MongoDB : query situations
 MongoDB --> SituationRouter : data
 SituationRouter --> APIClient : JSON response
 APIClient --> FrontEnd : parsed data
 FrontEnd --> User : display page

 alt reviewer decision
   User -> FrontEnd : approve or reject situation
   FrontEnd -> APIClient : submit decision
   APIClient -> FastAPIApp : HTTP POST decision
   FastAPIApp -> SituationRouter : update status
   SituationRouter -> MongoDB : update situation
   MongoDB --> SituationRouter : update result
   SituationRouter --> FrontEnd : updated situation
 end
@enduml

@startuml PresentationDeployment
 title Presentation Layer - Deployment Diagram
 actor User
 node "Client Machine" {
   node "Web Browser" {
     artifact "React/Vite Frontend" as Frontend
     component "Presentation Layer" as Presentation
     component "API Client" as APIClient
   }
 }
 node "Application Host" {
   node "FastAPI Process" {
     component "FastAPI Application" as FastAPI
     component "Situation Router" as SituationRouter
   }
 }
 User --> Frontend : uses
 Frontend --> Presentation : renders
 Presentation --> APIClient : calls
 APIClient --> FastAPI : HTTP/JSON
 FastAPI --> SituationRouter : routes request
@enduml

@startuml OrchestrationSequence
 title Orchestration Layer - Sequence Diagram
 actor Client
 participant FastAPIApp
 participant IngestionRouter
 participant ProcessingRouter
 participant SituationRouter
 participant ModuleService

 Client -> FastAPIApp : send HTTP request
 FastAPIApp -> FastAPIApp : validate middleware/CORS
 alt ingestion request
   FastAPIApp -> IngestionRouter : route request
   IngestionRouter -> ModuleService : invoke ingestion logic
 else processing request
   FastAPIApp -> ProcessingRouter : route request
   ProcessingRouter -> ModuleService : invoke processing logic
 else situation request
   FastAPIApp -> SituationRouter : route request
   SituationRouter -> ModuleService : invoke situation logic
 end
 ModuleService --> FastAPIApp : operation result
 FastAPIApp --> Client : HTTP/JSON response
@enduml

@startuml OrchestrationDeployment
 title Orchestration Layer - Deployment Diagram
 node "Application Host" {
   node "Python Runtime" {
     artifact "app/main.py" as Main
     component "FastAPIApp" as FastAPI
     component "IngestionRouter" as Ingestion
     component "ProcessingRouter" as Processing
     component "SituationRouter" as Situation
   }
 }
 node "Client or Tool Host" {
   component "HTTP Client" as Client
 }
 Client --> FastAPI : HTTP/JSON
 Main ..> FastAPI : starts
 FastAPI *-- Ingestion
 FastAPI *-- Processing
 FastAPI *-- Situation
@enduml

@startuml InputProcessingSequence
 title Input Processing Module - Sequence Diagram
 actor "CSV Producer" as Producer
 participant IngestionService
 participant QueueManager
 participant Preprocessor
 participant LanguageDetector
 participant AnalysisEngine

 Producer -> IngestionService : submit RawEvent
 IngestionService -> IngestionService : validate and enrich event
 IngestionService -> QueueManager : enqueue QueueItem
 QueueManager --> IngestionService : enqueue response
 QueueManager -> Preprocessor : dequeue item
 Preprocessor -> Preprocessor : clean and deduplicate text
 Preprocessor -> LanguageDetector : detect language
 LanguageDetector --> Preprocessor : LanguageInfo
 Preprocessor --> AnalysisEngine : PreprocessResult
 AnalysisEngine --> Producer : processed event response
@enduml

@startuml InputProcessingDeployment
 title Input Processing Module - Deployment Diagram
 node "Tools Host" {
   artifact "CSV Dataset" as Dataset
   component "CSV Producer" as Producer
 }
 node "Application Host" {
   node "FastAPI Process" {
     component "Ingestion Service" as Ingestion
     component "Queue Manager" as Queue
     component "Preprocessor" as Preprocessor
     component "Language Detector" as Language
   }
 }
 Producer --> Dataset : reads
 Producer --> Ingestion : HTTP POST
 Ingestion --> Queue : function call
 Queue --> Preprocessor : queued event
 Preprocessor --> Language : function call
@enduml

@startuml AnalysisSequence
 title Analysis Module - Sequence Diagram
 participant ProcessingRouter
 participant AnalysisEngine
 participant DisasterClassifier
 participant NeedDetector
 participant SentimentAnalyzer
 participant FakeNewsScorer
 participant PriorityScorer
 participant Combiner
 participant ClusterManager

 ProcessingRouter -> AnalysisEngine : analyze ProcessedPost
 AnalysisEngine -> DisasterClassifier : classify text
 DisasterClassifier --> AnalysisEngine : disaster result
 AnalysisEngine -> NeedDetector : detect needs
 NeedDetector --> AnalysisEngine : need scores
 AnalysisEngine -> SentimentAnalyzer : analyze sentiment
 SentimentAnalyzer --> AnalysisEngine : sentiment result
 AnalysisEngine -> FakeNewsScorer : score reliability risk
 FakeNewsScorer --> AnalysisEngine : fake-news result
 AnalysisEngine -> PriorityScorer : calculate priority
 PriorityScorer --> AnalysisEngine : priority result
 AnalysisEngine -> Combiner : combine model outputs
 Combiner --> AnalysisEngine : AnalysisResult
 AnalysisEngine --> ClusterManager : send AnalysisResult
@enduml

