@startuml AnalysisUseCases
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
actor "Input Processing Module" as Input
actor "Clustering Module" as Clustering
actor "Admin / Analyst" as Admin
rectangle "Analysis Module" {
  usecase "Run Analysis Pipeline" as A1
  usecase "Classify Disaster" as A2
  usecase "Detect Department Needs" as A3
  usecase "Analyze Sentiment" as A4
  usecase "Calculate Severity" as A5
  usecase "Calculate Actionability" as A6
  usecase "Combine Analysis Outputs" as A7
  usecase "Use Zero-Shot Fallback" as A8
  usecase "Calculate Fake Score" as A9
  usecase "Configure Model Thresholds" as A10
  usecase "Evaluate Model Metrics" as A11
}
Input --> A1
A1 ..> A2 : <<include>>
A1 ..> A3 : <<include>>
A1 ..> A4 : <<include>>
A2 --> A7
A3 --> A7
A4 --> A7
A7 ..> A5 : <<include>>
A7 ..> A6 : <<include>>
A8 ..> A3 : <<extend>>
A7 --> Clustering : sends result
A1 ..> A9 : <<include>>
Admin --> A10
Admin --> A11
@enduml

