actor "Admin / Analyst" as Admin
actor "Persistent Module" as Persistence
rectangle "Review and Routing Module" {
  usecase "View Pending Situation" as R1
  usecase "View Evidence" as R2
  usecase "Vote True or Fake" as R3
  usecase "Approve Situation" as R4
  usecase "Reject Situation" as R5
  usecase "Auto-Demote Linked Situations" as R6
  usecase "Route Confirmed Situation" as R7
  usecase "View Department Queue" as R8
  usecase "Acknowledge Situation" as R9
  usecase "Mark Situation Resolved" as R10
