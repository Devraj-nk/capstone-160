'' Per-module use-case diagrams for the Disaster Information Analysis System
'' Reference: docs/classDiagrams/ModulesRelation.png
'' Copy one @startuml/@enduml block at a time into draw.io PlantUML.

@startuml PresentationUseCases
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
actor "Human Reviewer" as Reviewer
actor "Admin / Analyst" as Admin
rectangle "Presentation Layer" {
  usecase "Open Review Console" as P1
  usecase "View Pending Situations" as P2
  usecase "Approve Situation" as P3
  usecase "Reject Situation" as P4
  usecase "Open Dashboard" as P5
  usecase "View Situation Summary" as P6
  usecase "View Department Counts" as P7
}
Reviewer --> P1
Reviewer --> P2
Reviewer --> P3
Reviewer --> P4
Admin --> P5
Admin --> P6
Admin --> P7
P3 ..> P2 : <<include>>
P4 ..> P2 : <<include>>
@enduml

@startuml OrchestrationUseCases
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
actor "Social Media Source /\nSimulator" as Source
actor "Frontend Client" as Frontend
rectangle "Orchestration Layer" {
  usecase "Receive Ingestion Request" as O1
  usecase "Receive Processing Request" as O2
  usecase "Receive Situation Request" as O3
  usecase "Register Routers" as O4
  usecase "Return Health Status" as O5
}
Source --> O1
Frontend --> O2
Frontend --> O3
O4 ..> O1 : <<include>>
O4 ..> O2 : <<include>>
O4 ..> O3 : <<include>>
@enduml

