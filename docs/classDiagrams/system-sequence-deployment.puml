' ============================================================================
' System sequence and deployment diagrams
' Disaster Information Analysis System
'
' The backend is a modular monolith: all backend modules execute in one
' FastAPI process. Each @startuml/@enduml block is a separate diagram.
' ============================================================================

@startuml SystemSequence
title End-to-End System Sequence
autonumber
hide footbox
actor "Data Source" as Src
actor Reviewer as Rev
participant "FastAPI Backend" as API
participant "Pipeline Worker" as P
database MongoDB as DB

Src -> API : POST /ingestion/ingest
API -> P : enqueue post
P -> P : clean, detect language, filter,\nanalyse, cluster, score
P -> DB : save situation + evidence
Rev -> API : GET /situations
API -> DB : fetch pending by priority
Rev -> API : POST /situations/{id}/decision
API -> DB : update status, open tickets
note over P, DB : Critical/High auto-routed after 1/5 min unless likely fake
@enduml


@startuml SystemDeployment
 title System Packaging and Deployment Diagram
 left to right direction
 skinparam shadowing false
 skinparam componentStyle rectangle

 actor "System User" as User
 cloud "Input Data Source" as DataSource

 node "Client Machine" as ClientMachine {
   node "Web Browser" as Browser {
     artifact "React/Vite Frontend" as FrontendArtifact
     component "Presentation Layer" as Presentation
   }
 }

 node "Application Host" as ApplicationHost {
   node "Vite Development Server" as ViteServer {
     artifact "frontend/dist or Vite app" as ViteArtifact
   }

   node "Python Runtime" as PythonRuntime {
     artifact "app/main.py" as MainArtifact
     component "FastAPI Application" as FastAPIApp

     package "Orchestration Layer" {
       component "Ingestion Router" as IngestionRouter
       component "Processing Router" as ProcessingRouter
       component "Clustering Router" as ClusteringRouter
       component "Situation Router" as SituationRouter
       component "Evidence Router" as EvidenceRouter
       component "Queue Router" as QueueRouter
       component "Summarization Router" as SummarizationRouter
     }

     package "Input Processing Module" {
       component "Queue Manager" as QueueManager
       component "Preprocessor" as Preprocessor
       component "Language Detector" as LanguageDetector
     }

     package "Analysis Module" {
       component "Analysis Engine" as AnalysisEngine
       component "Transformers and PyTorch Models" as AnalysisModels
     }

     package "Clustering Module" {
       component "Cluster Manager" as ClusterManager
       component "Embedding Generator" as EmbeddingGenerator
     }

     package "Situation Module" {
       component "Situation Manager" as SituationManager
       component "Summarizer" as Summarizer
     }

     package "Evidence Module" {
       component "Evidence Manager" as EvidenceManager
       component "Privacy Manager" as PrivacyManager
       component "Evidence Ranker" as EvidenceRanker
     }

     package "Persistent Module" {
       component "Database Client" as DatabaseClient
     }
   }
 }

 node "External Tools Host" as ToolsHost {
   artifact "CSV Dataset" as CSVData
   component "CSV Producer" as CSVProducer
 }

 database "MongoDB Server" as MongoDB {
   artifact "situations collection" as SituationsCollection
   artifact "evidence collection" as EvidenceCollection
 }

 User --> Browser : uses
 Browser --> ViteServer : loads frontend over HTTP
 Presentation --> FastAPIApp : REST/JSON over HTTP

 CSVProducer --> CSVData : reads
 CSVProducer --> IngestionRouter : POST /ingestion/ingest

 MainArtifact ..> FastAPIApp : starts
 FastAPIApp *-- IngestionRouter
 FastAPIApp *-- ProcessingRouter
 FastAPIApp *-- ClusteringRouter
 FastAPIApp *-- SituationRouter
 FastAPIApp *-- EvidenceRouter
 FastAPIApp *-- QueueRouter
 FastAPIApp *-- SummarizationRouter

 IngestionRouter --> QueueManager : function call
 QueueManager --> Preprocessor : queued event
 Preprocessor --> LanguageDetector : function call
 ProcessingRouter --> AnalysisEngine : function call
 AnalysisEngine --> AnalysisModels : in-process inference
 AnalysisEngine --> ClusterManager : analysis result
 ClusteringRouter --> ClusterManager : function call
 ClusterManager --> EmbeddingGenerator : embedding request
 ClusterManager --> SituationManager : significant cluster
 SituationManager --> Summarizer : summary request
 SituationManager --> EvidenceManager : evidence request
 EvidenceManager --> EvidenceRanker : select posts
 EvidenceManager --> PrivacyManager : mask data

 SituationRouter --> DatabaseClient : async database call
 EvidenceManager --> DatabaseClient : async database call
 DatabaseClient --> MongoDB : Motor driver / MongoDB protocol
 MongoDB o-- SituationsCollection
 MongoDB o-- EvidenceCollection

 note right of PythonRuntime
 One Python process contains the FastAPI application,
 routers, processing modules, ML inference, clustering,
 situation management, evidence management, and database client.
 end note

 note right of MongoDB
 Persistent storage is external to the FastAPI process.
 The queue and active clusters are currently in-memory.
 end note

 note bottom of ToolsHost
 CSV Producer is an external development and testing tool.
 It is not part of the deployed FastAPI application.
 end note
@enduml
