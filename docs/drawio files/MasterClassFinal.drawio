        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Frontend {\n  +viewDashboard()\n  +viewSituations()\n  +reviewEvidence()\n}\n\nclass FastAPIApplication {\n  +receiveRequest()\n  +returnResponse()\n}\n\nclass IngestionAndQueue {\n  +ingestPost()\n  +validatePost()\n  +queuePost()\n  +dequeuePost()\n}\n\nclass Preprocessing {\n  +cleanText()\n  +removeDuplicates()\n  +detectLanguage()\n}\n\nclass Analysis {\n  +classifyDisaster()\n  +detectNeeds()\n  +analyzeSentiment()\n  +calculatePriority()\n  +detectFakeNews()\n}\n\nclass SituationManagement {\n  +createSituation()\n  +generateSummary()\n  +combineResults()\n  +updateSituation()\n}\n\nclass EvidenceManagement {\n  +extractEvidence()\n  +generateEmbeddings()\n  +rankEvidence()\n}\n\nclass Database {\n  +saveData()\n  +retrieveSituations()\n  +retrieveEvidence()\n}\n\nclass Event {\n  +text\n  +source\n  +timestamp\n  +language\n}\n\nclass Situation {\n  +title\n  +summary\n  +priority\n  +status\n}\n\nclass Evidence {\n  +text\n  +source\n  +relevanceScore\n}\n\nFrontend --&gt; FastAPIApplication : sends requests\nFastAPIApplication --&gt; IngestionAndQueue : receives posts\nIngestionAndQueue --&gt; Event : creates\nIngestionAndQueue --&gt; Preprocessing : sends events\nPreprocessing --&gt; Analysis : sends processed text\nAnalysis --&gt; SituationManagement : sends analysis results\nSituationManagement --&gt; Situation : creates\nSituationManagement --&gt; EvidenceManagement : requests evidence\nEvidenceManagement --&gt; Evidence : creates\nSituationManagement --&gt; Database : stores situations\nEvidenceManagement --&gt; Database : stores evidence\nFrontend --&gt; Database : views processed results&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="JOecyxYzX3U4GJhvelhx-1">
